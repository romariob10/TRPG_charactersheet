{
  "name": "@mycharacter/pdf",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./src/index.ts",
    "import": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint --config eslint.config.mjs src test",
    "typecheck": "tsc --noEmit --skipLibCheck --module NodeNext --moduleResolution NodeNext --target ES2022 src/*.ts test/*.ts",
    "test": "vitest run --passWithNoTests",
    "build": "tsc --declaration --skipLibCheck --outDir dist --module NodeNext --moduleResolution NodeNext --target ES2022 src/index.ts"
  },
  "dependencies": {
    "@mycharacter/contracts": "workspace:*",
    "@napi-rs/canvas": "^1.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
