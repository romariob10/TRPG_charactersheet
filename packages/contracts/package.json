{
  "name": "@mycharacter/contracts",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./src/index.ts",
    "import": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint --config eslint.config.mjs src",
    "typecheck": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 src/index.ts",
    "test": "vitest run --passWithNoTests",
    "build": "tsc --declaration --outDir dist --module NodeNext --moduleResolution NodeNext --target ES2022 src/index.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
