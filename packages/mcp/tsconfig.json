{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@mycharacter/contracts": [
        "../contracts/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
