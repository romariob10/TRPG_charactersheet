{
  "name": "@mycharacter/storage",
  "version": "0.0.9",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./src/index.ts",
    "import": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint --config eslint.config.mjs src test",
    "typecheck": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 src/*.ts test/*.ts",
    "test": "vitest run --passWithNoTests",
    "build": "tsc --declaration --outDir dist --module NodeNext --moduleResolution NodeNext --target ES2022 src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0"
  }
}
