# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=22
ARG PNPM_VERSION=11.7.0

FROM postgres:17-bookworm AS postgresql-tools

FROM node:${NODE_VERSION}-bookworm-slim AS base
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global "pnpm@${PNPM_VERSION}"

FROM base AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/api/package.json ./apps/api/package.json
COPY apps/worker/package.json ./apps/worker/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/database/package.json ./packages/database/package.json
COPY packages/pdf/package.json ./packages/pdf/package.json
COPY packages/storage/package.json ./packages/storage/package.json
COPY packages/mcp/package.json ./packages/mcp/package.json
RUN --mount=type=cache,id=mycharacter-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM dependencies AS api-development
ENV NODE_ENV=development
COPY . .
CMD ["sh", "-c", "pnpm --filter @mycharacter/database build && pnpm --filter @mycharacter/storage build && pnpm --filter @mycharacter/pdf build && pnpm --filter @mycharacter/api dev"]

FROM dependencies AS worker-development
ENV NODE_ENV=development
COPY . .
CMD ["pnpm", "--filter", "@mycharacter/worker", "dev"]

FROM dependencies AS builder
ENV NODE_ENV=production
COPY . .
RUN pnpm --filter @mycharacter/contracts build \
    && pnpm --filter @mycharacter/database build \
    && pnpm --filter @mycharacter/storage build \
    && pnpm --filter @mycharacter/pdf build \
    && pnpm --filter @mycharacter/api build \
    && pnpm --filter @mycharacter/worker build

FROM base AS production-runtime
ENV NODE_ENV=production
COPY --from=builder /app/eng.traineddata /app/tessdata/eng.traineddata
COPY --from=builder /app/rus.traineddata /app/tessdata/rus.traineddata
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/contracts/package.json ./packages/contracts/package.json
COPY --from=builder /app/packages/contracts/node_modules ./packages/contracts/node_modules
COPY --from=builder /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=builder /app/packages/database/package.json ./packages/database/package.json
COPY --from=builder /app/packages/database/node_modules ./packages/database/node_modules
COPY --from=builder /app/packages/database/dist ./packages/database/dist
COPY --from=builder /app/packages/storage/package.json ./packages/storage/package.json
COPY --from=builder /app/packages/storage/node_modules ./packages/storage/node_modules
COPY --from=builder /app/packages/storage/dist ./packages/storage/dist
COPY --from=builder /app/packages/pdf/package.json ./packages/pdf/package.json
COPY --from=builder /app/packages/pdf/node_modules ./packages/pdf/node_modules
COPY --from=builder /app/packages/pdf/dist ./packages/pdf/dist

FROM production-runtime AS api-production
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/api/dist ./apps/api/dist
CMD ["node", "apps/api/dist/index.js"]

FROM production-runtime AS worker-production
ENV OCR_LANG_PATH=/app/tessdata \
    STORAGE_ROOT=/var/lib/mycharacter/pdfs
COPY --from=builder /app/apps/worker/package.json ./apps/worker/package.json
COPY --from=builder /app/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=builder /app/apps/worker/dist ./apps/worker/dist
CMD ["node", "apps/worker/dist/main.js"]

FROM production-runtime AS operations
ENV PATH=/usr/lib/postgresql/17/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/lib/postgresql17
COPY --from=postgresql-tools /usr/lib/postgresql/17/bin /usr/lib/postgresql/17/bin
COPY --from=postgresql-tools /lib/*/libpq.so.5* /usr/local/lib/postgresql17/
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/scripts ./scripts
CMD ["node", "scripts/verify-storage.mjs"]
