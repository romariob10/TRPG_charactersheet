# Скопируйте в .env.prod. Не коммитьте .env.prod.
# Используйте длинный URL-safe пароль: буквы, цифры, "_" и "-".
POSTGRES_DB=mycharacter
POSTGRES_USER=mycharacter
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Для первого запуска на этом компьютере:
CADDY_SITE_ADDRESS=http://localhost
PUBLIC_ORIGIN=http://localhost
# Необязательно: дополнительные допустимые адреса через запятую.
ALLOWED_ORIGINS=
COOKIE_SECURE=false
NEXT_PUBLIC_APP_URL=http://localhost

# Для домена замените четыре строки выше, например:
# CADDY_SITE_ADDRESS=characters.example.com
# PUBLIC_ORIGIN=https://characters.example.com
# COOKIE_SECURE=true
# NEXT_PUBLIC_APP_URL=https://characters.example.com

# QwenCloud Token Plan: нужен отдельный ключ с префиксом sk-sp- из консоли Token Plan.
AI_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_PRIMARY_API_KEY=
AI_CHAT_MODEL=qwen3.8-max-preview
AI_VISION_MODEL=qwen3.8-max-preview
AI_VISION_SUPPORTS_IMAGES=true

# S3, MinIO, Selectel и другие S3-совместимые хранилища. Если bucket не
# указан, приложение продолжит использовать локальный Docker volume.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=mycharacter
