# Скопируйте в .env.prod. Не коммитьте .env.prod.
# Используйте длинный URL-safe пароль: буквы, цифры, "_" и "-".
POSTGRES_DB=mycharacter
POSTGRES_USER=mycharacter
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Для первого запуска на этом компьютере:
CADDY_SITE_ADDRESS=http://localhost
PUBLIC_ORIGIN=http://localhost
COOKIE_SECURE=false
NEXT_PUBLIC_APP_URL=http://localhost

# Для домена замените четыре строки выше, например:
# CADDY_SITE_ADDRESS=characters.example.com
# PUBLIC_ORIGIN=https://characters.example.com
# COOKIE_SECURE=true
# NEXT_PUBLIC_APP_URL=https://characters.example.com

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_PRIMARY_API_KEY=
AI_CHAT_MODEL=
AI_VISION_MODEL=
AI_VISION_SUPPORTS_IMAGES=true
