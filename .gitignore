# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnpm-store/
/**/dist/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/**/test-results
/playwright-report

# Tesseract may cache bundled language data in a package working directory.
/**/eng.traineddata
/**/rus.traineddata
!/eng.traineddata
!/rus.traineddata

# next.js
/**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.prod.example
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent worktrees
/.worktrees/

# Supabase CLI local state
/supabase/.branches/
/supabase/.temp/
