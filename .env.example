# Public Supabase project configuration (Settings → API Keys → Publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only Supabase secret key. Never expose this variable to the browser.
SUPABASE_SECRET_KEY=sb_secret_your-key

# OpenAI-compatible chat and vision endpoint
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-api-key
# Optional key override used when rotating providers without deleting the old key first.
AI_PRIMARY_API_KEY=
AI_CHAT_MODEL=your-tool-calling-model
AI_VISION_MODEL=your-vision-model
AI_VISION_SUPPORTS_IMAGES=true

# Inngest Cloud keys for production. Local Compose uses the keyless Dev Server.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Public application URL used to build invite links
NEXT_PUBLIC_APP_URL=http://localhost:3000
