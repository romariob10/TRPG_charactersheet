# Локальный запуск: скопируйте файл в .env.local.
PUBLIC_ORIGIN=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://web.mycharacter.orb.local,https://web.mycharacter.orb.local
COOKIE_SECURE=false
NEXT_PUBLIC_APP_URL=http://localhost:8080

# QwenCloud Token Plan: нужен отдельный ключ с префиксом sk-sp- из консоли Token Plan.
# AI необязателен: без ключа приложение работает, но AI-помощник отключён.
AI_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_PRIMARY_API_KEY=
AI_CHAT_MODEL=qwen3.8-max-preview
AI_VISION_MODEL=qwen3.8-max-preview
AI_VISION_SUPPORTS_IMAGES=true

# Необязательно: S3-совместимое хранилище для PDF и изображений постов.
# Если S3_BUCKET пуст, локальная разработка использует Docker volume.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=mycharacter
